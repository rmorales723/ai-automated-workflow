package com.robertmorales.handson3;

public class HandsOn
{

	public static void main(String[] args)
	{
		// TODO Auto-generated method stub
		int[] values = {0, 0, 0, 0, 0};
		
		for(int i = 0; i < values.length; i++)
		{
			System.out.println("Print out number: ");
			values[i] = StudentHelper.ReadInputInt();
		}
		
//			print array contents
			System.out.println("Print array contents: ");
			for (int val: values)
			{
				System.out.println(val);
			}
			
//			print array in reverse order
			System.out.println("Print array in reverse: ");
			for (int i = values.length - 1; i >= 0; i--)
			{
				System.out.println(values[i]);
			}
			
			// print array contents where index is odd
	        System.out.println("Array Contents at Odd Indices");
	        for(int i = 0; i < values.length; i++) 
	        {
	            if(i % 2 != 0) {
	                System.out.println("Value at odd index " + i + ": " + values[i]);
	        }
	  }
	}
}

